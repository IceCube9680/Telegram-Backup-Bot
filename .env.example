# ==============================================================================
# Telegram Backup Bot — Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Choices: development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT (REQUIRED)
# ------------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram (format: 123456789:ABCdef...)
BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_MODE=polling

# ------------------------------------------------------------------------------
# 3. MONGODB DATABASE (REQUIRED)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=telegram_backup
MONGODB_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 4. SECURITY & CRYPTOGRAPHIC SECRETS (REQUIRED IN PRODUCTION)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ------------------------------------------------------------------------------
SECRET_KEY=change_this_to_a_secure_random_string_at_least_32_chars
JWT_SECRET=change_this_to_a_secure_random_string_at_least_32_chars
WEB_SESSION_SECRET=change_this_to_a_secure_random_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 5. WEB DASHBOARD & REST API
# ------------------------------------------------------------------------------
WEB_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000
WEB_BASE_URL=http://localhost:8000
WEB_COOKIE_NAME=backup_bot_session
# WEB_COOKIE_SECURE automatically defaults to true in production
WEB_COOKIE_SECURE=false
WEB_COOKIE_SAMESITE=lax
WEB_ALLOWED_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------------------------
# 6. STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_PATH=./storage
MAX_FILE_SIZE=4294967296
DISK_WARNING_THRESHOLD_PCT=80.0
DISK_CRITICAL_THRESHOLD_PCT=90.0

# ------------------------------------------------------------------------------
# 7. BACKGROUND WORKER CONFIGURATION
# ------------------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_ID=worker_primary
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=2.0
WORKER_LOCK_TIMEOUT=300
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY=2.0
WORKER_RETRY_MAX_DELAY=60.0
WORKER_DOWNLOAD_CHUNK_SIZE=65536
WORKER_HEARTBEAT_INTERVAL=30.0

# ------------------------------------------------------------------------------
# 8. MTPROTO LARGE FILE INGESTION (PHASE 10: 20 MiB - 4 GiB SUPPORT)
# ------------------------------------------------------------------------------
# Enable MTProto telethon backend for Telegram files > 20 MiB up to 4 GiB
MT_PROTO_ENABLED=false
# Obtain MT_PROTO_API_ID and MT_PROTO_API_HASH from https://my.telegram.org
MT_PROTO_API_ID=
MT_PROTO_API_HASH=
# Path to Telethon session file (must be outside web root, chmod 0600)
MT_PROTO_SESSION_PATH=./secrets/telegram_bot_mtproto.session
# Chunk size for MTProto transfers (default: 1048576 bytes = 1 MiB)
MT_PROTO_CHUNK_SIZE=1048576
MT_PROTO_CONCURRENCY=1
MT_PROTO_MAX_ATTEMPTS=5
MT_PROTO_RETRY_BASE_DELAY=2.0
MT_PROTO_RETRY_MAX_DELAY=60.0
# Files > 20 MiB (20971520 bytes) route through MTProto; <= 20 MiB use Bot API
LARGE_FILE_THRESHOLD=20971520
# Enable resumable streaming downloads for interrupted MTProto tasks
LARGE_FILE_RESUME_ENABLED=true
# Minimum disk headroom required before accepting large downloads (bytes)
LARGE_FILE_DISK_SAFETY_MARGIN=1073741824

# ------------------------------------------------------------------------------
# 9. S3 COMPATIBLE STORAGE (OPTIONAL)
# ------------------------------------------------------------------------------
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
